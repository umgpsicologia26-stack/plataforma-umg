APP_NAME=VitaSafe-Reverb-Test
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database.reverb-testing.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=reverb

# Listener interno local de Reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=6001

# Destino para publicaciones desde Laravel (interno)
REVERB_APP_ID=local-vitasafe-test
REVERB_APP_KEY=local-test-key
REVERB_APP_SECRET=local-test-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=6001
REVERB_SCHEME=http

# Cliente Echo: conexión directa local al puerto de Reverb
VITE_REVERB_APP_KEY=local-test-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

MAIL_MAILER=log
